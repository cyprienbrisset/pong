# ---------------------------------------------------------------------------
# Neon Pong 2026 — variables d'environnement
# Sur Coolify, à saisir dans l'onglet « Environment Variables » du service.
# ---------------------------------------------------------------------------

NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Base SQLite. DOIT pointer vers un volume persistant, sinon le classement
# disparaît à chaque redéploiement.
DB_PATH=/data/neon-pong.db

# Fichiers statiques du client (déjà positionné dans l'image Docker).
PUBLIC_DIR=/app/packages/client/dist

# Garde-fous mémoire et CPU. Sur un Kimsufi d'entrée de gamme, descendre
# MAX_ROOMS à 16 laisse de la marge.
MAX_ROOMS=64
ROOM_IDLE_MS=60000
RATE_LIMIT_MSG_PER_SEC=180

# Origines autorisées à ouvrir la WebSocket. Vide = tout accepter (développement
# uniquement). En production, renseigner le domaine exact.
ALLOWED_ORIGINS=https://pong.exemple.fr

LOG_LEVEL=info
# Les adresses IP ne sont pas journalisées par défaut : donnée personnelle,
# aucun intérêt fonctionnel ici.
LOG_IPS=false
